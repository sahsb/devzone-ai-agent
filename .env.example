# Copy this file to .env and fill in your own values.
PORT=3000
JWT_SECRET=replace_this_with_a_long_random_secret
AI_API_KEY=
# OpenAI-compatible API endpoint. Keep the key on the server; never put it in public HTML.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional: set to true only when testing locally
COOKIE_SECURE=false
